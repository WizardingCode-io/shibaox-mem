{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "shibaox-mem",
            "type": "command",
            "command": "\"${extensionPath}/bin/shibaox-mem\" hook gemini session-start --via-plugin",
            "timeout": 5000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "shibaox-mem",
            "type": "command",
            "command": "\"${extensionPath}/bin/shibaox-mem\" hook gemini prompt --via-plugin",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "shibaox-mem",
            "type": "command",
            "command": "\"${extensionPath}/bin/shibaox-mem\" hook gemini turn-end --via-plugin",
            "timeout": 5000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "name": "shibaox-mem",
            "type": "command",
            "command": "\"${extensionPath}/bin/shibaox-mem\" hook gemini session-end --via-plugin",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
